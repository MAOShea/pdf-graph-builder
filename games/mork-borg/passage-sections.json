  "anchor_matching": {
    "strategy": "heading_regex",
    "case_insensitive": true,
    "normalize_whitespace": true,
    "multiline": true,
    "notes": "Whole-line regex anchors. Future: add min_font_size_ratio from PyMuPDF spans to disambiguate body mentions. Index page hints are not used for matching."
  },
  "entity_passage": {
    "enabled": true,
    "columns": [
      "CREATURES"
    ],
    "notes": "Design: entity-scoped RulePassage boundaries live in this contract (same spirit as sections[] anchors and lookup_tables.pdf_extract.stop_before). Python only compiles/matches. Start = creature heading on page; end = min(next index title on page, first stop_before hit). Optional per creatures_index row: text_end_hint (exclusive literal or regex) when shared stop_before is wrong.",
    "end_detection": {
      "order": [
        "next_index_title_on_page",
        "stop_before"
      ],
      "stop_before": [
        {
          "type": "line_regex",
          "pattern": "^(?:Head|Captured|Dead|Skull|Corpse|Horn|Remains|Ectoplasm|Destroyed|Decapitated\\s+lantern|Poison\\s+gland|Tail\\s+spike|Blood(?:\\s*,\\s*per\\s+litre)?)\\s+\\d+(?:\\s*[–\\-]\\s*\\d+)?s(?:\\s*\\([^)]*\\))?\\s*$",
          "notes": "Label then silver tally, e.g. Head 7s / Captured 50-120s (...)"
        },
        {
          "type": "line_regex",
          "pattern": "^\\d+(?:\\s*[–\\-]\\s*\\d+)?s\\s+(?:Head|Captured|Dead|Skull|Corpse|Horn|Remains|Ectoplasm|Destroyed|Decapitated\\s+lantern|Poison\\s+gland|Tail\\s+spike|Blood(?:\\s*,\\s*per\\s+litre)?)(?:\\s*\\([^)]*\\))?\\s*$",
          "notes": "Silver then label, e.g. 200s Captured"
        }
      ],
      "stop_before_flags": "im"
    }
  },
