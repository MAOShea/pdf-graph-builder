{
  "id": "mork-borg-operational-spines",
  "game": "mork-borg",
  "version": "0.4.5",
  "status": "draft",
  "description": "Altitude-D adjudicable If spines: D1 Violence DR12, D2 Crit/fumble/rest/infection, D3 creature attack/defence DR overrides via Circumstance-[:APPLIES_TO]->creature instance (opaque If.id — no creature name in id). D3 overrides SUPERSEDES matching D1 defaults (Briefing 22). Slice 2c Morale procedure FOR MoraleCheck (Briefing 25); Compare COMPARED_TO sheet Morale. Slice 2d More HP FOR Advancement COMPARED_TO HitPoints; Ability changes FOR Advancement COMPARED_TO AbilityScore (low-band SUPERSEDES default). Slice 2e Powers FOR Power: daily uses formula (no Compare) + scroll Presence DR12. Closed vocabulary only.",
  "verified_against": "MÖRK BORG BARE BONES EDITION.pdf",
  "verified_date": "2026-08-20",
  "creature_dr_overrides": {
    "enabled": true,
    "circumstance_role": "fighting",
    "notes": "Batch CREATURES entity passages. First matching extract_rule wins. Skip ability-test / infection / paralysis DR lines.",
    "extract_rules": [
      {
        "id": "attacks_and_defence",
        "pattern": "attacks?\\s+and\\s+defen[cs]e(?:\\s+are)?\\s+DR\\s*(\\d+)",
        "procedures": ["MeleeAttack", "RangedAttack", "DefenseRoll"]
      },
      {
        "id": "attacks_are",
        "pattern": "attacks?\\s+are\\s+DR\\s*(\\d+)",
        "procedures": ["MeleeAttack", "RangedAttack"]
      },
      {
        "id": "to_hit_them",
        "pattern": "DR\\s*(\\d+)\\s+to\\s+hit\\s+them",
        "procedures": ["MeleeAttack", "RangedAttack"]
      },
      {
        "id": "to_hit_parenthetical",
        "pattern": "(?:easy|difficult|hard)\\s+to\\s+hit\\s*\\(?\\s*DR\\s*(\\d+)",
        "procedures": ["MeleeAttack", "RangedAttack"]
      }
    ]
  },
  "spines": [
    {
      "id": "if:melee-hit-default",
      "for_procedure": "MeleeAttack",
      "combinator": "LEAF",
      "atom": {
        "kind": "compare_dr",
        "id": "compare:melee-dr12",
        "threshold": 12
      },
      "bool_id": "bool:melee-hit-default",
      "then": {
        "id": "outcome:melee-hit",
        "name": "hit",
        "summary": "Melee attack hits (test meets or beats DR)."
      },
      "else": {
        "id": "outcome:melee-miss",
        "name": "miss",
        "summary": "Melee attack misses."
      },
      "evidence": {
        "section_id": "violence-combat",
        "text_contains_any": ["Test Strength"]
      },
      "notes": "Test Strength DR12"
    },
    {
      "id": "if:ranged-hit-default",
      "for_procedure": "RangedAttack",
      "combinator": "LEAF",
      "atom": {
        "kind": "compare_dr",
        "id": "compare:ranged-dr12",
        "threshold": 12
      },
      "bool_id": "bool:ranged-hit-default",
      "then": {
        "id": "outcome:ranged-hit",
        "name": "hit",
        "summary": "Ranged attack hits (test meets or beats DR)."
      },
      "else": {
        "id": "outcome:ranged-miss",
        "name": "miss",
        "summary": "Ranged attack misses."
      },
      "evidence": {
        "section_id": "violence-combat",
        "text_contains_any": ["Test Presence"]
      },
      "notes": "Test Presence DR12"
    },
    {
      "id": "if:defence-default",
      "for_procedure": "DefenseRoll",
      "combinator": "LEAF",
      "atom": {
        "kind": "compare_dr",
        "id": "compare:defence-dr12",
        "threshold": 12
      },
      "bool_id": "bool:defence-default",
      "then": {
        "id": "outcome:defence-success",
        "name": "defend",
        "summary": "Defence succeeds (test meets or beats DR)."
      },
      "else": {
        "id": "outcome:defence-fail",
        "name": "hit-by-enemy",
        "summary": "Defence fails; enemy hits you."
      },
      "evidence": {
        "section_id": "violence-combat",
        "text_contains_any": ["Test Agility"]
      },
      "notes": "Test Agility DR12"
    },
    {
      "id": "if:crit-attack",
      "for_procedures": ["MeleeAttack", "RangedAttack"],
      "combinator": "LEAF",
      "atom": {
        "kind": "compare_face",
        "id": "compare:natural-20",
        "op": "=",
        "left": "natural_face",
        "threshold": 20
      },
      "bool_id": "bool:crit-attack",
      "then": [
        {
          "id": "outcome:crit-double-damage",
          "name": "double-damage",
          "summary": "Crit on attack: double damage."
        },
        {
          "id": "outcome:crit-armor-tier-down",
          "name": "armor-tier-down",
          "summary": "Crit on attack: armor/protection reduced one tier."
        }
      ],
      "evidence": {
        "section_id": "crit-fumble-rest",
        "text_contains_any": ["Double damage", "armor/protection"]
      },
      "notes": "One If with two FOR (MeleeAttack + RangedAttack). Bare Bones defence crit is different (PC gains a free attack) — not this spine; see handoff."
    },
    {
      "id": "if:fumble-defence",
      "for_procedure": "DefenseRoll",
      "combinator": "LEAF",
      "atom": {
        "kind": "compare_face",
        "id": "compare:natural-1",
        "op": "=",
        "left": "natural_face",
        "threshold": 1
      },
      "bool_id": "bool:fumble-defence",
      "then": [
        {
          "id": "outcome:fumble-defence-double-damage",
          "name": "double-damage",
          "summary": "Fumbled defence: PC takes double damage."
        },
        {
          "id": "outcome:fumble-defence-armor-tier-down",
          "name": "armor-tier-down",
          "summary": "Fumbled defence: armor reduced one tier."
        }
      ],
      "evidence": {
        "section_id": "crit-fumble-rest",
        "text_contains_any": ["Fumble", "double damage", "armor is reduced"]
      },
      "notes": "Defence fumble (natural 1). Attack fumble (weapon breaks/lost) deferred."
    },
    {
      "id": "if:rest-catch-breath",
      "for_procedure": "Downtime",
      "combinator": "LEAF",
      "atom": {
        "kind": "circumstance",
        "id": "circumstance:catch-breath-and-drink",
        "name": "catch breath and drink"
      },
      "bool_id": "bool:rest-catch-breath",
      "then": {
        "id": "outcome:rest-restore-d4-hp",
        "name": "restore-d4-hp",
        "summary": "Catch breath and drink: restore d4 HP."
      },
      "evidence": {
        "section_id": "rest",
        "text_contains_any": ["Catch your breath", "Restore d4"]
      },
      "notes": "FOR Downtime (no Rest SeedNode). Circumstance situating atom."
    },
    {
      "id": "if:infection-blocks-rest",
      "for_procedure": "Downtime",
      "combinator": "AND",
      "atoms": [
        {
          "kind": "circumstance",
          "id": "circumstance:infected",
          "name": "Infected"
        },
        {
          "kind": "circumstance",
          "id": "circumstance:resting",
          "name": "resting"
        }
      ],
      "bool_id": "bool:infection-blocks-rest",
      "then": {
        "id": "outcome:infection-no-rest-benefit",
        "name": "no-rest-benefit",
        "summary": "Infected: no HP restored from resting; instead lose d6 HP daily."
      },
      "evidence": {
        "section_id": "rest",
        "text_contains_any": ["infected character", "does not benefit"]
      },
      "notes": "AND of Circumstance Infected + resting (not status Condition). Book: infected does not benefit from resting; d6 HP lost daily."
    },
    {
      "id": "if:morale-trigger",
      "for_procedure": "MoraleCheck",
      "combinator": "OR",
      "atoms": [
        {
          "kind": "circumstance",
          "id": "circumstance:leader-killed",
          "name": "leader is killed"
        },
        {
          "kind": "circumstance",
          "id": "circumstance:half-group-eliminated",
          "name": "half the group is eliminated"
        },
        {
          "kind": "circumstance",
          "id": "circumstance:enemy-one-third-hp",
          "name": "a single enemy has only 1/3 of its HP left"
        }
      ],
      "bool_id": "bool:morale-trigger",
      "then": {
        "id": "outcome:morale-roll-2d6",
        "name": "roll-2d6-vs-morale",
        "summary": "Roll for morale: 2d6 against the creature's Morale value."
      },
      "evidence": {
        "section_id": "morale",
        "text_contains_any": ["Roll for morale", "leader is killed"]
      },
      "notes": "Slice 2c / Briefing 25: roll-morale triggers (OR). FOR MoraleCheck (procedure); sheet SeedNode:Morale stays HAS_MORALE / COMPARED_TO only."
    },
    {
      "id": "if:morale-demoralized",
      "for_procedure": "MoraleCheck",
      "combinator": "LEAF",
      "atom": {
        "kind": "compare",
        "id": "compare:2d6-gt-morale",
        "op": ">",
        "left": "2d6",
        "compared_to": "Morale"
      },
      "bool_id": "bool:morale-demoralized",
      "then": {
        "id": "outcome:demoralized",
        "name": "demoralized",
        "summary": "2d6 greater than Morale: creature is demoralized."
      },
      "else": {
        "id": "outcome:morale-holds",
        "name": "morale-holds",
        "summary": "2d6 not greater than Morale: creature continues."
      },
      "evidence": {
        "section_id": "morale",
        "text_contains_any": ["greater than the creature", "demoralized"]
      },
      "notes": "FOR MoraleCheck. Compare 2d6 > creature Morale (COMPARED_TO SeedNode:Morale; threshold from sheet HAS_MORALE at runtime)."
    },
    {
      "id": "if:morale-flee-or-surrender",
      "for_procedure": "MoraleCheck",
      "combinator": "AND",
      "atoms": [
        {
          "kind": "circumstance",
          "id": "circumstance:demoralized",
          "name": "demoralized"
        },
        {
          "kind": "compare_face",
          "id": "compare:d6-flee-band",
          "op": "<=",
          "left": "d6",
          "threshold": 3
        }
      ],
      "bool_id": "bool:morale-flee-or-surrender",
      "then": {
        "id": "outcome:morale-flees",
        "name": "flees",
        "summary": "Demoralized: d6 1–3 → enemy flees."
      },
      "else": {
        "id": "outcome:morale-surrenders",
        "name": "surrenders",
        "summary": "Demoralized: d6 4–6 → enemy surrenders."
      },
      "evidence": {
        "section_id": "morale",
        "text_contains_any": ["flees", "surrenders"]
      },
      "notes": "FOR MoraleCheck. Bare Bones: Roll d6 — (1–3) flees or (4–6) surrenders. AND demoralized + d6<=3 → flee; ELSE surrender."
    },
    {
      "id": "if:improve-hp",
      "for_procedure": "Advancement",
      "combinator": "LEAF",
      "atom": {
        "kind": "compare",
        "id": "compare:6d10-ge-max-hp",
        "op": ">=",
        "left": "6d10",
        "compared_to": "HitPoints"
      },
      "bool_id": "bool:improve-hp",
      "then": {
        "id": "outcome:improve-hp-gain-d6",
        "name": "increase-max-hp-d6",
        "summary": "6d10 equal to or greater than current maximum HP: increase maximum HP by d6."
      },
      "else": {
        "id": "outcome:improve-hp-no-gain",
        "name": "no-hp-gain",
        "summary": "6d10 below current maximum HP: maximum HP does not increase."
      },
      "evidence": {
        "section_id": "getting-better-or-worse",
        "text_contains_any": ["Roll 6d10", "maximum HP"]
      },
      "notes": "Slice 2d / Getting Better More HP. FOR Advancement (procedure); sheet SeedNode:HitPoints stays HAS_HIT_POINTS / COMPARED_TO only. Threshold is the PC's current max from the situation, not a seed constant."
    },
    {
      "id": "if:ability-change-default",
      "for_procedure": "Advancement",
      "combinator": "LEAF",
      "atom": {
        "kind": "compare",
        "id": "compare:d6-ge-ability",
        "op": ">=",
        "left": "d6",
        "compared_to": "AbilityScore"
      },
      "bool_id": "bool:ability-change-default",
      "then": {
        "id": "outcome:ability-increase-1",
        "name": "increase-ability-1",
        "summary": "d6 equal to or greater than the ability: increase it by 1, to a maximum of +6."
      },
      "else": {
        "id": "outcome:ability-decrease-1",
        "name": "decrease-ability-1",
        "summary": "d6 below the ability: decrease it by 1."
      },
      "evidence": {
        "section_id": "getting-better-or-worse",
        "text_contains_any": ["Roll a d6 against every ability", "maximum of +6"]
      },
      "notes": "Slice 2d / Getting Better Ability changes default. FOR Advancement; COMPARED_TO AbilityScore (situation value, not a seed threshold). Cap +6 is the THEN outcome, not a Compare threshold."
    },
    {
      "id": "if:ability-change-low",
      "for_procedure": "Advancement",
      "combinator": "AND",
      "atoms": [
        {
          "kind": "compare",
          "id": "compare:ability-ge-minus-3",
          "op": ">=",
          "left": "AbilityScore",
          "threshold": -3,
          "compared_to": "AbilityScore"
        },
        {
          "kind": "compare",
          "id": "compare:ability-le-plus-1",
          "op": "<=",
          "left": "AbilityScore",
          "threshold": 1,
          "compared_to": "AbilityScore"
        },
        {
          "kind": "compare",
          "id": "compare:ability-d6-eq-1",
          "op": "=",
          "left": "d6",
          "threshold": 1
        }
      ],
      "bool_id": "bool:ability-change-low",
      "then": {
        "id": "outcome:ability-low-nat1-decrease",
        "name": "decrease-ability-1-floor-minus-3",
        "summary": "Abilities from −3 to +1 and d6 is 1: reduce by 1, never below −3."
      },
      "supersedes": "if:ability-change-default",
      "evidence": {
        "section_id": "getting-better-or-worse",
        "text_contains_any": ["Abilities from", "unless the d6 result is 1", "never below"]
      },
      "notes": "Slice 2d / Getting Better Ability changes override. Band + nat 1 SUPERSEDES the default d6>=ability increase (which would otherwise always succeed in this band). No ELSE — when the AND is false, the default If applies."
    },
    {
      "id": "if:power-daily-uses",
      "for_procedure": "Power",
      "combinator": "LEAF",
      "atom": {
        "kind": "circumstance",
        "id": "circumstance:morning-power-uses",
        "name": "every morning"
      },
      "bool_id": "bool:power-daily-uses",
      "then": {
        "id": "outcome:power-uses-presence-plus-d4",
        "name": "daily-uses-presence-plus-d4",
        "summary": "Daily Power uses = Presence + d4 (roll each morning; choose from available scrolls)."
      },
      "evidence": {
        "section_id": "powers-and-scrolls",
        "text_contains_any": ["Roll Presence + d4", "every morning"]
      },
      "notes": "Slice 2e W1. Formula lives on the Outcome — not a Compare (Compare is yes/no). FOR Power; procedure APPLIES_TO Presence. Do not encode 1+3=4 in Python."
    },
    {
      "id": "if:power-scroll-read",
      "for_procedure": "Power",
      "combinator": "LEAF",
      "atom": {
        "kind": "compare_dr",
        "id": "compare:power-scroll-dr12",
        "threshold": 12
      },
      "bool_id": "bool:power-scroll-read",
      "then": {
        "id": "outcome:power-activates",
        "name": "activate-and-spend-use",
        "summary": "Scroll Power activates; subtract one use from the daily total."
      },
      "else": {
        "id": "outcome:power-fail",
        "name": "fail-d2-dizzy",
        "summary": "Power doesn't work; lose d2 HP; dizzy for the next hour; Powers fail in the worst possible way."
      },
      "evidence": {
        "section_id": "powers-and-scrolls",
        "text_contains_any": ["When reading a scroll", "test Presence DR12"]
      },
      "notes": "Slice 2e W2. Ordinary Presence DR12 Compare on FOR Power. Cite preamble only — not Unclean/Sacred catalogue rows. Nested Foul d6 is OQ-ADAPT-07."
    }
  ]
}
